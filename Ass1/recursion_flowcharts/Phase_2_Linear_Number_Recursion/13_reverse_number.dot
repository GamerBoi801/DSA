digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input n", shape=parallelogram];
    call  [label="Call reverse(n, rev = 0)", shape=rectangle];
    base  [label="n == 0 ?", shape=diamond];
    retr  [label="Return rev", shape=rectangle];
    upd   [label="rev = rev * 10 + (n % 10)\nn = n / 10", shape=rectangle];
    rec   [label="Call reverse(n, rev)", shape=rectangle];
    out   [label="Print / Return rev", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> retr [label="Yes"];
    base -> upd [label="No"];
    upd -> rec -> base [label="recursive call"];
    retr -> out;
    out -> endn;
}
