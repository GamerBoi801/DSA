digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input array arr[], size n", shape=parallelogram];
    call  [label="Call printArr(arr, i = 0, n)", shape=rectangle];
    base  [label="i == n ?", shape=diamond];
    ret   [label="Return", shape=rectangle];
    out   [label="Print arr[i]", shape=parallelogram];
    rec   [label="Call printArr(arr, i + 1, n)", shape=rectangle];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret [label="Yes"];
    base -> out [label="No"];
    out -> rec -> base [label="recursive call"];
    ret -> endn;
}
