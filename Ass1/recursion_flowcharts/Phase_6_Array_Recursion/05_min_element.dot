digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input array arr[], size n", shape=parallelogram];
    call  [label="Call findMin(arr, i = 0, n)", shape=rectangle];
    base  [label="i == n - 1 ?\n(last element)", shape=diamond];
    retl  [label="Return arr[i]", shape=rectangle];
    rec   [label="Call findMin(arr, i + 1, n)\nrestMin = findMin(arr, i+1, n)", shape=rectangle];
    cmp   [label="result = min(arr[i], restMin)", shape=rectangle];
    out   [label="Print / Return result", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> retl [label="Yes"];
    base -> rec [label="No"];
    rec -> base [label="recursive call"];
    rec -> cmp [label="on return"];
    cmp -> out;
    retl -> out [style=dashed, label="unwind"];
    out -> endn;
}
