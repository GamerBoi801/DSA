digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input array arr[], size n", shape=parallelogram];
    call  [label="Call printRev(arr, i = 0, n)", shape=rectangle];
    base  [label="i == n ?", shape=diamond];
    ret   [label="Return", shape=rectangle];
    rec   [label="Call printRev(arr, i + 1, n)", shape=rectangle];
    out   [label="Print arr[i]\n(executed after recursive\ncall returns)", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret [label="Yes"];
    base -> rec [label="No"];
    rec -> base [label="recursive call"];
    rec -> out [label="on return"];
    out -> endn [style=dashed, label="unwind"];
    ret -> endn;
}
