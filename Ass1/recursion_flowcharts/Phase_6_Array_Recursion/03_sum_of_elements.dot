digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input array arr[], size n", shape=parallelogram];
    call  [label="Call sumArr(arr, i = 0, n)", shape=rectangle];
    base  [label="i == n ?", shape=diamond];
    ret0  [label="Return 0", shape=rectangle];
    rec   [label="Call sumArr(arr, i + 1, n)", shape=rectangle];
    add   [label="result = arr[i] + sumArr(arr, i+1, n)", shape=rectangle];
    out   [label="Print / Return result", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret0 [label="Yes"];
    base -> rec [label="No"];
    rec -> base [label="recursive call"];
    rec -> add [label="on return"];
    add -> out;
    ret0 -> out [style=dashed, label="unwind"];
    out -> endn;
}
