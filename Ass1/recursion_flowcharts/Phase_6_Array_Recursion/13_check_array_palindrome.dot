digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input array arr[], size n", shape=parallelogram];
    call  [label="Call isPalinArr(arr, start = 0, end = n-1)", shape=rectangle];
    base  [label="start >= end ?", shape=diamond];
    retT  [label="Return true", shape=rectangle];
    cmp   [label="arr[start] != arr[end] ?", shape=diamond];
    retF  [label="Return false", shape=rectangle];
    rec   [label="Call isPalinArr(arr, start+1, end-1)", shape=rectangle];
    outY  [label="Print \"Palindrome Array\"", shape=parallelogram];
    outN  [label="Print \"Not Palindrome\"", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> retT [label="Yes"];
    base -> cmp [label="No"];
    cmp -> retF [label="Yes (mismatch)"];
    cmp -> rec [label="No"];
    rec -> base [label="recursive call"];
    retT -> outY;
    retF -> outN;
    outY -> endn;
    outN -> endn;
}
