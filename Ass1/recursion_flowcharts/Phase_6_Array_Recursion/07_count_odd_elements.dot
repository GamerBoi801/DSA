digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input array arr[], size n", shape=parallelogram];
    call  [label="Call countOdd(arr, i = 0, n)", shape=rectangle];
    base  [label="i == n ?", shape=diamond];
    ret0  [label="Return 0", shape=rectangle];
    chk   [label="arr[i] % 2 != 0 ?", shape=diamond];
    rec2  [label="Call countOdd(arr,i+1,n)\nresult = 1 + countOdd(...)", shape=rectangle];
    rec1  [label="Call countOdd(arr,i+1,n)\nresult = countOdd(...)", shape=rectangle];
    out   [label="Print / Return result", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret0 [label="Yes"];
    base -> chk [label="No"];
    chk -> rec2 [label="Yes"];
    chk -> rec1 [label="No"];
    rec1 -> base [label="recursive call"];
    rec2 -> base [label="recursive call"];
    rec1 -> out [label="on return"];
    rec2 -> out [label="on return"];
    ret0 -> out [style=dashed, label="unwind"];
    out -> endn;
}
