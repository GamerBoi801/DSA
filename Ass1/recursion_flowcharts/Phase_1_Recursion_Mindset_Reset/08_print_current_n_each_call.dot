digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];

    start [label="Start", shape=oval];
    inp   [label="Input n", shape=parallelogram];
    call  [label="Call trace(n)", shape=rectangle];
    out   [label="Print current value of n", shape=parallelogram];
    base  [label="n == 0 ?", shape=diamond];
    ret   [label="Return", shape=rectangle];
    rec   [label="Call trace(n - 1)", shape=rectangle];
    endn  [label="End", shape=oval];

    start -> inp;
    inp -> call;
    call -> out;
    out -> base;
    base -> ret [label="Yes"];
    base -> rec [label="No"];
    rec -> out [label="recursive call"];
    ret -> endn;
}
