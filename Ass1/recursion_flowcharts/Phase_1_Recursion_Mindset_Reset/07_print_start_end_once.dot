digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];

    start  [label="Start", shape=oval];
    call   [label="Call demo(n)", shape=rectangle];
    isFirst[label="n == original value?\n(first call)", shape=diamond];
    printS [label="Print \"Start\"", shape=parallelogram];
    base   [label="n == 0 ?", shape=diamond];
    rec    [label="Call demo(n - 1)", shape=rectangle];
    isLast [label="n == 0?\n(deepest call)", shape=diamond];
    printE [label="Print \"End\"", shape=parallelogram];
    ret    [label="Return", shape=rectangle];
    endn   [label="End", shape=oval];

    start -> call;
    call -> isFirst;
    isFirst -> printS [label="Yes"];
    isFirst -> base [label="No"];
    printS -> base;
    base -> isLast [label="Yes"];
    base -> rec [label="No"];
    rec -> base [label="recursive call"];
    isLast -> printE [label="Yes"];
    printE -> ret;
    ret -> endn;
}
