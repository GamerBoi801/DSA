digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input n", shape=parallelogram];
    call  [label="Call trailingZeros(n, p = 5)", shape=rectangle];
    base  [label="n / p == 0 ?", shape=diamond];
    ret0  [label="Return 0", shape=rectangle];
    rec   [label="Call trailingZeros(n, p * 5)", shape=rectangle];
    add   [label="result = (n / p) + trailingZeros(n, p*5)", shape=rectangle];
    out   [label="Print / Return result\n(count of factor 5s in n!)", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret0 [label="Yes"];
    base -> rec [label="No"];
    rec -> base [label="recursive call"];
    rec -> add [label="on return"];
    add -> out;
    ret0 -> out [style=dashed, label="unwind"];
    out -> endn;
}
