digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input a, b", shape=parallelogram];
    gcdcall [label="Call gcd(a, b) recursively\n(Euclid's algorithm)", shape=rectangle];
    base  [label="b == 0 ?", shape=diamond];
    reta  [label="Return a (this is gcd)", shape=rectangle];
    rec   [label="Call gcd(b, a % b)", shape=rectangle];
    compute [label="lcm = (a * b) / gcd(a, b)", shape=rectangle];
    out   [label="Print / Return lcm", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> gcdcall -> base;
    base -> reta [label="Yes"];
    base -> rec [label="No"];
    rec -> base [label="recursive call"];
    reta -> compute [style=dashed, label="unwind"];
    rec -> compute [label="propagate gcd"];
    compute -> out;
    out -> endn;
}
