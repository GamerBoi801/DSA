digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input n, target digit d", shape=parallelogram];
    call  [label="Call countDigit(n, d)", shape=rectangle];
    base  [label="n == 0 ?", shape=diamond];
    ret0  [label="Return 0", shape=rectangle];
    chk   [label="(n % 10) == d ?", shape=diamond];
    rec1  [label="Call countDigit(n / 10, d)\nresult = countDigit(n/10, d)", shape=rectangle];
    rec2  [label="Call countDigit(n / 10, d)\nresult = 1 + countDigit(n/10, d)", shape=rectangle];
    out   [label="Print / Return result", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret0 [label="Yes"];
    base -> chk [label="No"];
    chk -> rec2 [label="Yes"];
    chk -> rec1 [label="No"];
    rec1 -> base [label="recursive call"];
    rec2 -> base [label="recursive call"];
    rec1 -> out [label="on return"];
    rec2 -> out [label="on return"];
    ret0 -> out [style=dashed, label="unwind"];
    out -> endn;
}
