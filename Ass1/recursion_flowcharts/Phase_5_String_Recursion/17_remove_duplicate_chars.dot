digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input string s", shape=parallelogram];
    call  [label="Call removeDup(s, i = 0, seen = {})", shape=rectangle];
    base  [label="i == s.length() ?", shape=diamond];
    rete  [label="Return \"\" (empty string)", shape=rectangle];
    chk   [label="s[i] already in seen set ?", shape=diamond];
    mark  [label="Add s[i] to seen set", shape=rectangle];
    rec2  [label="Call removeDup(s,i+1,seen)\nresult = s[i] + removeDup(...)", shape=rectangle];
    rec1  [label="Call removeDup(s,i+1,seen)\nresult = removeDup(s,i+1,seen)", shape=rectangle];
    out   [label="Print / Return result", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> rete [label="Yes"];
    base -> chk [label="No"];
    chk -> rec1 [label="Yes (skip duplicate)"];
    chk -> mark [label="No (first time)"];
    mark -> rec2;
    rec1 -> base [label="recursive call"];
    rec2 -> base [label="recursive call"];
    rec1 -> out [label="on return"];
    rec2 -> out [label="on return"];
    rete -> out [style=dashed, label="unwind"];
    out -> endn;
}
