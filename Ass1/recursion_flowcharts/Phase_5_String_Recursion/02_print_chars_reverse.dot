digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input string s", shape=parallelogram];
    call  [label="Call printRev(s, i = 0)", shape=rectangle];
    base  [label="i == s.length() ?", shape=diamond];
    ret   [label="Return", shape=rectangle];
    rec   [label="Call printRev(s, i + 1)", shape=rectangle];
    out   [label="Print s[i]\n(executed after recursive\ncall returns)", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret [label="Yes"];
    base -> rec [label="No"];
    rec -> base [label="recursive call"];
    rec -> out [label="on return"];
    out -> endn [style=dashed, label="unwind"];
    ret -> endn;
}
