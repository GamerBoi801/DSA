digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input string s, char oldC, char newC", shape=parallelogram];
    call  [label="Call replaceChar(s, i = 0, oldC, newC)", shape=rectangle];
    base  [label="i == s.length() ?", shape=diamond];
    rete  [label="Return \"\" (empty string)", shape=rectangle];
    chk   [label="s[i] == oldC ?", shape=diamond];
    rec1  [label="Call replaceChar(s,i+1,...)\nresult = newC + replaceChar(...)", shape=rectangle];
    rec2  [label="Call replaceChar(s,i+1,...)\nresult = s[i] + replaceChar(...)", shape=rectangle];
    out   [label="Print / Return result", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> rete [label="Yes"];
    base -> chk [label="No"];
    chk -> rec1 [label="Yes"];
    chk -> rec2 [label="No"];
    rec1 -> base [label="recursive call"];
    rec2 -> base [label="recursive call"];
    rec1 -> out [label="on return"];
    rec2 -> out [label="on return"];
    rete -> out [style=dashed, label="unwind"];
    out -> endn;
}
