digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input n", shape=parallelogram];
    call  [label="Call pyramid(i = 1, n)", shape=rectangle];
    base  [label="i > n ?", shape=diamond];
    ret   [label="Return", shape=rectangle];
    spc   [label="Call printSpaces(n - i)\n(leading spaces)", shape=rectangle];
    inner [label="Call printStars(2*i - 1)\n(stars for this row)", shape=rectangle];
    nl    [label="Print newline", shape=parallelogram];
    rec   [label="Call pyramid(i + 1, n)", shape=rectangle];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret [label="Yes"];
    base -> spc [label="No"];
    spc -> inner -> nl -> rec -> base [label="recursive call"];
    ret -> endn;
}
