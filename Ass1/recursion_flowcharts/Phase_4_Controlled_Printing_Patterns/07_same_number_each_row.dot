digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input n, num", shape=parallelogram];
    call  [label="Call printRows(i = 1, n, num)", shape=rectangle];
    base  [label="i > n ?", shape=diamond];
    ret   [label="Return", shape=rectangle];
    inner [label="Call printSame(num, i)\n(prints num, i times on this row)", shape=rectangle];
    nl    [label="Print newline", shape=parallelogram];
    rec   [label="Call printRows(i + 1, n, num)", shape=rectangle];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret [label="Yes"];
    base -> inner [label="No"];
    inner -> nl -> rec -> base [label="recursive call"];
    ret -> endn;
}
