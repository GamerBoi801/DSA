digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input n", shape=parallelogram];
    call  [label="Call triangle(i = 1, n)", shape=rectangle];
    base  [label="i > n ?", shape=diamond];
    ret   [label="Return", shape=rectangle];
    rec   [label="Call triangle(i + 1, n)", shape=rectangle];
    inner [label="Call printStars(i)\n(prints i stars, executed\nafter recursive call returns)", shape=rectangle];
    nl    [label="Print newline", shape=parallelogram];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret [label="Yes"];
    base -> rec [label="No"];
    rec -> base [label="recursive call"];
    rec -> inner [label="on return"];
    inner -> nl;
    nl -> endn [style=dashed, label="unwind"];
    ret -> endn;
}
