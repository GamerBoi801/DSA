digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input n", shape=parallelogram];
    call  [label="Call sumSeries(i = 1, n, runningSum = 0)", shape=rectangle];
    base  [label="i > n ?", shape=diamond];
    ret   [label="Return runningSum\n(final total)", shape=rectangle];
    upd   [label="runningSum += i", shape=rectangle];
    out   [label="Print \"Sum up to \", i, \" = \", runningSum", shape=parallelogram];
    rec   [label="Call sumSeries(i + 1, n, runningSum)", shape=rectangle];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret [label="Yes"];
    base -> upd [label="No"];
    upd -> out -> rec -> base [label="recursive call"];
    ret -> endn;
}
