digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start [label="Start", shape=oval];
    inp   [label="Input n", shape=parallelogram];
    call  [label="Call printRows(n)", shape=rectangle];
    base  [label="n == 0 ?", shape=diamond];
    ret   [label="Return", shape=rectangle];
    inner [label="Call printStars(n)\n(prints n stars, helper recursion)", shape=rectangle];
    nl    [label="Print newline", shape=parallelogram];
    rec   [label="Call printRows(n - 1)", shape=rectangle];
    endn  [label="End", shape=oval];
    start -> inp -> call -> base;
    base -> ret [label="Yes"];
    base -> inner [label="No"];
    inner -> nl -> rec -> base [label="recursive call"];
    ret -> endn;
}
