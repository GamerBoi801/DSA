digraph G {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    start  [label="Start", shape=oval];
    inp    [label="Input n", shape=parallelogram];
    callR  [label="Call printRows(i = 1, n)\n(outer recursive function)", shape=rectangle];
    baseR  [label="i > n ?", shape=diamond];
    retR   [label="Return", shape=rectangle];
    callC  [label="Call printCols(j = 1, i)\n(inner recursive function\nfor current row)", shape=rectangle];
    baseC  [label="j > i ?", shape=diamond];
    retC   [label="Return", shape=rectangle];
    outC   [label="Print symbol", shape=parallelogram];
    recC   [label="Call printCols(j + 1, i)", shape=rectangle];
    nl     [label="Print newline", shape=parallelogram];
    recR   [label="Call printRows(i + 1, n)", shape=rectangle];
    endn   [label="End", shape=oval];
    start -> inp -> callR -> baseR;
    baseR -> retR [label="Yes"];
    baseR -> callC [label="No"];
    callC -> baseC;
    baseC -> retC [label="Yes"];
    baseC -> outC [label="No"];
    outC -> recC -> baseC [label="recursive call"];
    retC -> nl [style=dashed];
    nl -> recR -> baseR [label="recursive call"];
    retR -> endn;
}
